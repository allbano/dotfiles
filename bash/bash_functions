# 4. Git functions
# =========================================================================== #
git_current_branch() {
    local branch
    branch=$(git branch --show-current 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -n "$branch" ]]; then
        echo -n "$branch"
    else
        echo "Este diretório não é um repositório git!"
    fi
}

pullDotfiles() {
    declare -A MSGS
    MSGS["check"]="Verificando dotfiles..."
    MSGS["update"]="Atualizando repositório de dotfiles..."
    LOCALPATH="$(pwd)"
    echo "${MSGS["check"]}"
    [[ ! -d "$DOTFILES"  ]] && exit 2
    echo "${MSGS["update"]}"
    cd "$DOTFILES" || return
    git pull -v --all
    cd "$LOCALPATH" || return
}

pushHis() {
    local LOCALPATH
    LOCALPATH="$(pwd)"
    local UPTODATE
    UPTODATE="$(date +%s)"
    local HPATH="$HOME/github/dotfiles/bash/history"
    local HISTNAMEBASE="${HOSTNAME}-history" 
    local HISTNAME="${HISTNAMEBASE}-${UPTODATE}"

    cd "$HPATH" || exit 1
    HIST="$(echo "${HISTNAMEBASE}"*)"
    ALLDEB=$(realpath "${HIST}")
    [[ -f "${ALLDEB}" ]] && rm "${ALLDEB}"
    cp -p "${HOME}/.bash_history" "${HPATH}/${HISTNAME}"
    git add "${HPATH}"
    git commit -m "Your bash_history on PC \"${HOSTNAME}\" was updated on $(date -d @"${UPTODATE}")"
    git push origin "$(git_current_branch)"
    cd "${LOCALPATH}" || exit 2
}

_cmdsh_fzf_search() {
    # Defina o caminho exato para o arquivo que o cmdsh gera
    local cmd_file="$HOME/github/dotfiles/bash/history/commands_history"
    local selected_command

    # Verifica se o arquivo existe para evitar erros
    if [[ ! -f "$cmd_file" ]]; then
        echo -e "\nArquivo não encontrado: $cmd_file"
        return 1
    fi

    # O fzf lê o arquivo. 
    # --height=40% e --layout=reverse deixam a interface parecida com o Ctrl+R padrão
    selected_command=$(cat "$cmd_file" | fzf --height=40% --layout=reverse --prompt="cmdsh> " --query="$READLINE_LINE")

    # Se você escolheu um comando (não cancelou com Esc)
    if [[ -n "$selected_command" ]]; then
        # Insere o comando na linha atual
        READLINE_LINE="$selected_command"
        # Move o cursor para o final do comando inserido
        READLINE_LINE=${#READLINE_LINE}
    fi
}











