#!/usr/bin/env bash

# ------------------------------------------------------------------------------- #
# Script      : bootstrap.sh
# Description : Instala e cria links simbólicos dos dotfiles para a home do usuário
# Version     : 1.0
# Author      : Albano Roberto Drescher Von Maywitz & Antigravity
# Data        : 12 de Julho de 2026
# ------------------------------------------------------------------------------- #

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_DIR="$HOME/.dotfiles_backup_$(date +%Y%m%d_%H%M%S)"
DRY_RUN=false
FORCE=false

# Mensagem de ajuda
usage() {
    echo "Uso: $(basename "$0") [OPÇÕES]"
    echo ""
    echo "Opções:"
    echo "  -d, --dry-run   Simula a instalação sem fazer alterações reais"
    echo "  -f, --force     Sobrescreve configurações existentes sem perguntar"
    echo "  -h, --help      Exibe esta ajuda e sai"
    exit 0
}

# Tratamento de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dry-run) DRY_RUN=true; shift ;;
        -f|--force) FORCE=true; shift ;;
        -h|--help) usage ;;
        *) echo "Opção inválida: $1" >&2; usage ;;
    esac
done

# Imprime com cores
info() { echo -e "\e[34m[INFO]\e[0m $*"; }
success() { echo -e "\e[32m[SUCESSO]\e[0m $*"; }
warn() { echo -e "\e[33m[AVISO]\e[0m $*"; }
error() { echo -e "\e[31m[ERRO]\e[0m $*"; }

# Cria o diretório de backup se necessário
backup_file() {
    local target="$1"
    if [[ -e "$target" && ! -L "$target" ]]; then
        if $DRY_RUN; then
            info "[Dry-run] Faria backup de: $target -> $BACKUP_DIR/$(basename "$target")"
        else
            if [[ ! -d "$BACKUP_DIR" ]]; then
                mkdir -p "$BACKUP_DIR"
                info "Criado diretório de backup: $BACKUP_DIR"
            fi
            mv "$target" "$BACKUP_DIR/"
            warn "Backup criado: $target movido para $BACKUP_DIR/"
        fi
    fi
}

# Função principal para criar links simbólicos
link_file() {
    local src="$1"
    local dest="$2"
    
    # Resolve caminhos absolutos
    local src_abs="$DOTFILES_DIR/$src"
    local dest_abs
    dest_abs="${dest/#\~/$HOME}"
    
    # Se o arquivo de origem não existir, avisa e sai
    if [[ ! -e "$src_abs" ]]; then
        error "Origem não encontrada: $src_abs"
        return
    fi
    
    # Verifica se já está linkado corretamente
    if [[ -L "$dest_abs" && "$(readlink "$dest_abs")" == "$src_abs" ]]; then
        success "Já linkado: $dest_abs -> $src"
        return
    fi

    # Trata conflitos
    if [[ -e "$dest_abs" || -L "$dest_abs" ]]; then
        if $FORCE; then
            if ! $DRY_RUN; then
                if [[ -L "$dest_abs" ]]; then
                    rm "$dest_abs"
                else
                    backup_file "$dest_abs"
                fi
            fi
        else
            # Pergunta se o usuário quer sobrescrever/fazer backup
            read -p "O arquivo/pasta $dest já existe. Deseja sobrescrever? (s/N) " -n 1 -r
            echo
            if [[ $REPLY =~ ^[Ss]$ ]]; then
                if ! $DRY_RUN; then
                    if [[ -L "$dest_abs" ]]; then
                        rm "$dest_abs"
                    else
                        backup_file "$dest_abs"
                    fi
                fi
            else
                info "Ignorado: $dest"
                return
            fi
        fi
    fi

    # Garante que o diretório pai do destino exista
    local dest_parent
    dest_parent="$(dirname "$dest_abs")"
    if [[ ! -d "$dest_parent" ]]; then
        if $DRY_RUN; then
            info "[Dry-run] Faria diretório: $dest_parent"
        else
            mkdir -p "$dest_parent"
        fi
    fi

    # Cria o link
    if $DRY_RUN; then
        info "[Dry-run] Faria link simbólico: $dest_abs -> $src_abs"
    else
        ln -sf "$src_abs" "$dest_abs"
        success "Criado link: $dest_abs -> $src"
    fi
}

echo "========================================="
echo "   Iniciando Instalação dos Dotfiles   "
echo "========================================="
if $DRY_RUN; then
    warn "EXECUTANDO EM MODO DRY-RUN (SIMULAÇÃO)"
fi

# 1. Arquivos de configuração principais
link_file "bash/.bashrc" "~/.bashrc"
link_file "bash/bash_aliases" "~/.bash_aliases"
link_file "bash/bash_aliases" "~/.zsh_aliases"  # Também linka para o Zsh
link_file "bash/bash_functions" "~/.bash_functions"
link_file "bash/bash_profile" "~/.bash_profile"
link_file "zsh/.zshrc" "~/.zshrc"
link_file "zsh/zprofile" "~/.zprofile"
link_file "tmux/.tmux.conf" "~/.tmux.conf"
link_file "vim/.vimrc" "~/.vimrc"
link_file "git/.gitconfig" "~/.gitconfig"

# 2. Pastas de configuração em ~/.config/
link_file "alacritty" "~/.config/alacritty"
link_file "foot" "~/.config/foot"
link_file "ghostty" "~/.config/ghostty"
link_file "kitty" "~/.config/kitty"
link_file "qmmp" "~/.config/qmmp"

# 3. Scripts em ~/.local/bin/
info "Configurando links para scripts utilitários em ~/.local/bin/..."
if [[ -d "$DOTFILES_DIR/scripts" ]]; then
    for script_path in "$DOTFILES_DIR/scripts"/*; do
        if [[ -f "$script_path" ]]; then
            script_name="$(basename "$script_path")"
            link_file "scripts/$script_name" "~/.local/bin/$script_name"
        fi
    done
fi

echo "========================================="
echo "         Instalação Concluída!          "
echo "========================================="
