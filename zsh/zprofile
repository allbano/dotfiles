##### STANDARD CONFIG #####

# Add user's local bin directories to PATH
typeset -U PATH path
path=(
  "$HOME/bin"
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"
  $path
)


# Angular CLI autocompletion
if command -v ng 1>/dev/null 2>&1; then
  source <(ng completion script)
fi

# Extra PATH settings
path+=(
  /usr/sbin
  /sbin
)

# Export the updated path
export PATH

