# Monta um remote do rclone de forma interativa

set -euo pipefail

RCLONE_OPTIONS=(
  --vfs-cache-mode writes
  --allow-other
  --allow-non-empty
  --dir-cache-time 72h
  --vfs-cache-max-age 5m
  --vfs-read-chunk-size 128M
  --vfs-read-chunk-size-limit 1G
  --attr-timeout 1s
  --poll-interval 15s
  --log-level INFO
  --buffer-size 64M
)

REMOTE_NAME=""
REMOTE=""
MOUNTPOINT=""
CONFIG_FILE="$HOME/.config/account-rclone.conf"
SERVICE_NAME="account-rclone.service"
SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

fail() {
  echo "Erro: $*" >&2
  exit 1
}

check_dependencies() {
  command -v rclone >/dev/null 2>&1 || fail "'rclone' nao encontrado no PATH."
}

ask_mountpoint() {
  local input=""

  while true; do
    read -r -p "Informe o MOUNTPOINT absoluto - [exemplo ${HOME}/pasta-que-deseja-montar]: " input
    input="${input}"

    if [[ "$input" != /* ]]; then
      echo "O caminho deve ser absoluto (exemplo: /home/usuario/pasta)."
      continue
    fi

    MOUNTPOINT="$input"

    if [[ -e "$MOUNTPOINT" && ! -d "$MOUNTPOINT" ]]; then
      echo "O caminho existe, mas nao e um diretorio: $MOUNTPOINT"
      continue
    fi

    if [[ ! -d "$MOUNTPOINT" ]]; then
      mkdir -p "$MOUNTPOINT"
      echo "Diretorio criado: $MOUNTPOINT"
    fi

    break
  done
}

ask_remote_name() {
  local input=""

  while true; do
    read -r -p "Informe o nome do REMOTE a ser criado/uso (sem ':') [OneDrive]: " input
    input="${input:-OneDrive}"
    input="${input%:}"

    if [[ -z "$input" ]]; then
      echo "O nome do REMOTE nao pode ser vazio."
      continue
    fi

    REMOTE_NAME="$input"
    REMOTE="${REMOTE_NAME}:"
    break
  done
}

ensure_remote_exists() {
  local allow_prompt="${1:-yes}"

  if rclone listremotes | grep -Fxq "$REMOTE"; then
    return 0
  fi

  if [[ "$allow_prompt" != "yes" ]]; then
    fail "REMOTE '$REMOTE' nao foi encontrado."
  fi

  echo "REMOTE '$REMOTE' nao foi encontrado no rclone."
  read -r -p "Deseja abrir 'rclone config' agora para criar esse REMOTE? [s/N]: " reply

  case "$reply" in
    [sS]|[sS][iI][mM])
      rclone config
      ;;
    *)
      fail "REMOTE '$REMOTE' nao existe. Execute 'rclone config' e rode novamente."
      ;;
  esac

  rclone listremotes | grep -Fxq "$REMOTE" || fail "REMOTE '$REMOTE' ainda nao existe."
}

mount_remote() {
  local run_mode="${1:-background}"

  mkdir -p "$MOUNTPOINT"
  echo "Montando '$REMOTE' em '$MOUNTPOINT'..."

  if [[ "$run_mode" == "foreground" ]]; then
    exec rclone mount "$REMOTE" "$MOUNTPOINT" "${RCLONE_OPTIONS[@]}"
  fi

  rclone mount "$REMOTE" "$MOUNTPOINT" "${RCLONE_OPTIONS[@]}" & disown
  echo "Montagem iniciada em segundo plano."
}

save_config() {
  mkdir -p "$(dirname "$CONFIG_FILE")"
  cat > "$CONFIG_FILE" <<EOF
REMOTE_NAME="$REMOTE_NAME"
REMOTE="$REMOTE"
MOUNTPOINT="$MOUNTPOINT"
EOF
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || fail "Arquivo de configuracao nao encontrado: $CONFIG_FILE"

  # shellcheck source=/dev/null
  source "$CONFIG_FILE"

  [[ -n "${REMOTE:-}" ]] || fail "REMOTE invalido em $CONFIG_FILE"
  [[ -n "${MOUNTPOINT:-}" ]] || fail "MOUNTPOINT invalido em $CONFIG_FILE"
}

configure_mount_on_boot() {
  local reply=""
  local service_dir="$HOME/.config/systemd/user"
  local service_file="$service_dir/$SERVICE_NAME"

  read -r -p "Deseja montar automaticamente ao ligar o computador? [s/N]: " reply
  case "$reply" in
    [sS]|[sS][iI][mM]) ;;
    *)
      echo "Inicializacao automatica nao configurada."
      return 0
      ;;
  esac

  save_config
  mkdir -p "$service_dir"

  cat > "$service_file" <<EOF
[Unit]
Description=Montagem automatica rclone
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="$SCRIPT_PATH" --boot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF

  if command -v systemctl >/dev/null 2>&1; then
    if systemctl --user daemon-reload && systemctl --user enable "$SERVICE_NAME" >/dev/null; then
      echo "Servico '$SERVICE_NAME' habilitado para iniciar com o computador."
      echo "Arquivo do servico: $service_file"
      echo "Configuracao salva em: $CONFIG_FILE"
    else
      echo "Nao foi possivel habilitar o servico automaticamente via systemctl --user."
      echo "Arquivo do servico: $service_file"
    fi
  else
    echo "systemctl nao encontrado. Servico foi criado, mas voce precisa habilitar manualmente."
  fi
}

run_boot_mode() {
  check_dependencies
  load_config
  ensure_remote_exists no
  mount_remote foreground
}

main() {
  check_dependencies
  ask_mountpoint
  ask_remote_name
  ensure_remote_exists
  mount_remote background
  configure_mount_on_boot
}

if [[ "${1:-}" == "--boot" ]]; then
  run_boot_mode
else
  main
fi
